# Node
node_modules/
npm-debug.log*

# Local runtime config (may contain auth tokens / cert paths) — commit *.example.json only
server/config.json
agent/config.json
.env

# Android / Gradle
android/build/
android/app/build/
android/.gradle/
android/local.properties
*.apk
*.aab

# Release signing secrets — never commit
android/keystore.properties
android/keystore/

# Desktop app build output (Rust target tree, installers, generated schemas)
desktop/src-tauri/target/
desktop/src-tauri/gen/
*.msi

# win-pilot MCP runtime scratch (logs, screenshots, recordings) — not project code
runtime/

# OS / editor
.DS_Store
Thumbs.db

# Relay persisted identity + agent identity (token hashes / tokens) — never commit
server/data/
agent/state.json

# Claude Code worktrees / local session files
.claude/
