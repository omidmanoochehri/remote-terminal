{
  "server": "wss://relay.example.com",
  "enrollToken": "the-relay-ENROLL_TOKEN",
  "name": "Office PC",

  "stateFile": "./state.json",
  "defaultShell": "",
  "shells": null,

  "replayBytes": 262144,
  "maxInputBytes": 1048576,
  "maxSessions": 16,
  "sessionIdleTimeoutSec": 21600,
  "exitedRetentionSec": 300,

  "restoreSessions": true,
  "restoreCommands": true,
  "restoreMaxAgeSec": 86400,
  "sessionsFile": "./sessions.json",

  "metricsIntervalMs": 20000,

  "fileBrowser": true,
  "filesRoot": "",
  "maxFileWriteBytes": 536870912,
  "processManager": true,
  "allowProcessKill": true,
  "systemInfo": true,
  "portList": true,

  "inheritEnv": false,
  "runAsUser": "auto",
  "allowRoot": false,
  "logLevel": "info",
  "baseBackoffMs": 1000,
  "maxBackoffMs": 30000
}
