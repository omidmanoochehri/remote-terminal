<?xml version="1.0" encoding="utf-8"?>
<!-- Add-machine stepper pill: filled while active or done, quiet ahead. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/rt_primary_soft" />
            <stroke android:width="@dimen/rt_stroke" android:color="@color/rt_primary_edge" />
            <corners android:radius="@dimen/rt_radius_control" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rt_surface_tile" />
            <stroke android:width="@dimen/rt_stroke" android:color="@color/rt_divider" />
            <corners android:radius="@dimen/rt_radius_control" />
        </shape>
    </item>
</selector>
