<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded square behind an icon (header mark, list leading icon). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="@color/rt_surface_bright_top"
        android:endColor="@color/rt_surface_bright_bottom"
        android:type="linear" />
    <stroke android:width="@dimen/rt_stroke" android:color="@color/rt_outline_strong" />
    <corners android:radius="@dimen/rt_radius_icon_tile" />
</shape>
