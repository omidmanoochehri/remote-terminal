<?xml version="1.0" encoding="utf-8"?>
<!-- Terminal tab chip: green wash when it is the visible session. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/rt_primary_soft">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/rt_primary_soft" />
                    <stroke android:width="1.5dp" android:color="@color/rt_primary_edge" />
                    <corners android:radius="@dimen/rt_radius_field" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/rt_surface_tile" />
                    <stroke android:width="@dimen/rt_stroke" android:color="@color/rt_divider" />
                    <corners android:radius="@dimen/rt_radius_field" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
