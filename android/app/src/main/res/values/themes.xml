<resources>
    <!--
      Material 3 day/night theme mapped onto the Remote Terminal design tokens.
      Screens use the tokens directly; the Material mapping is what keeps
      dialogs, menus, snackbars and the preference screens on-palette.
    -->
    <style name="Theme.RemoteTerminal" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/rt_primary</item>
        <item name="colorOnPrimary">@color/rt_on_primary</item>
        <item name="colorPrimaryContainer">@color/rt_primary_soft</item>
        <item name="colorOnPrimaryContainer">@color/rt_primary</item>
        <item name="colorSecondary">@color/rt_accent</item>
        <item name="colorOnSecondary">@color/rt_on_primary</item>
        <item name="colorSecondaryContainer">@color/rt_accent_soft</item>
        <item name="colorOnSecondaryContainer">@color/rt_accent</item>
        <item name="colorTertiary">@color/rt_primary</item>
        <item name="colorError">@color/rt_status_error</item>
        <item name="android:colorBackground">@color/rt_bg_bottom</item>
        <item name="colorSurface">@color/rt_surface_top</item>
        <item name="colorSurfaceVariant">@color/rt_surface_bright_top</item>
        <item name="colorSurfaceContainer">@color/rt_surface_top</item>
        <item name="colorSurfaceContainerHigh">@color/rt_surface_bright_top</item>
        <item name="colorSurfaceContainerLow">@color/rt_surface_bottom</item>
        <item name="colorSurfaceContainerHighest">@color/rt_surface_bright_top</item>
        <item name="colorOnSurface">@color/rt_text</item>
        <item name="colorOnSurfaceVariant">@color/rt_text_muted</item>
        <item name="colorOutline">@color/rt_outline</item>
        <item name="colorOutlineVariant">@color/rt_divider</item>
        <item name="android:windowBackground">@drawable/rt_bg_screen</item>

        <!-- Edge to edge: the bars are transparent and each screen pads its own chrome. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>

        <!-- Component shapes from the design system (cards 18-20, controls 10-14). -->
        <item name="shapeAppearanceCornerExtraSmall">@style/Shape.RemoteTerminal.ExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/Shape.RemoteTerminal.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/Shape.RemoteTerminal.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/Shape.RemoteTerminal.Large</item>
        <item name="materialCardViewStyle">@style/Widget.RemoteTerminal.Card</item>
        <item name="materialButtonStyle">@style/Widget.RemoteTerminal.Button</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.RemoteTerminal.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.RemoteTerminal.BottomSheet</item>
        <item name="android:textColorPrimary">@color/rt_text</item>
        <item name="android:textColorSecondary">@color/rt_text_muted</item>
        <item name="android:textColorHint">@color/rt_text_muted</item>
    </style>

    <style name="Shape.RemoteTerminal.ExtraSmall" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerSize">8dp</item>
    </style>
    <style name="Shape.RemoteTerminal.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">12dp</item>
    </style>
    <style name="Shape.RemoteTerminal.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">14dp</item>
    </style>
    <style name="Shape.RemoteTerminal.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">18dp</item>
    </style>

    <style name="Widget.RemoteTerminal.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">@dimen/rt_radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">?attr/colorPrimary</item>
    </style>

    <style name="Widget.RemoteTerminal.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/rt_cta_height</item>
        <item name="cornerRadius">@dimen/rt_radius_control</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.005</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Dialogs, sheets and menus inherit the dark card surface. -->
    <style name="ThemeOverlay.RemoteTerminal.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/rt_surface_top</item>
        <item name="colorSurfaceContainerHigh">@color/rt_surface_top</item>
        <item name="android:colorBackground">@color/rt_surface_top</item>
        <item name="shapeAppearanceCornerLarge">@style/Shape.RemoteTerminal.Large</item>
        <item name="materialAlertDialogTitleTextStyle">@style/RtDialogTitle</item>
        <item name="buttonBarPositiveButtonStyle">@style/RtDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/RtDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/RtDialogButton</item>
    </style>

    <style name="RtDialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/rt_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="RtDialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/rt_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="ThemeOverlay.RemoteTerminal.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="colorSurface">@color/rt_surface_top</item>
        <item name="colorSurfaceContainerLow">@color/rt_surface_top</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Round icon button used by the app bars. -->
    <style name="Widget.RemoteTerminal.IconButton" parent="android:Widget.ImageButton">
        <item name="android:layout_width">@dimen/rt_header_action</item>
        <item name="android:layout_height">@dimen/rt_header_action</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/rt_icon_button</item>
        <item name="tint">@color/rt_text_secondary</item>
    </style>
</resources>
