<?xml version="1.0" encoding="utf-8"?>
<!--
  Machines: search, filters, then one card per machine. The list is a
  RecyclerView so long accounts stay smooth; the footer action and the
  empty/no-results block live inside the same scroll.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/headerBar"
        layout="@layout/view_screen_header" />

    <include
        android:id="@+id/searchBar"
        layout="@layout/view_search_field" />

    <HorizontalScrollView
        android:id="@+id/filterScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingStart="@dimen/rt_gutter"
        android:paddingEnd="@dimen/rt_gutter"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/filterRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <include
        android:id="@+id/banner"
        layout="@layout/view_connection_banner" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/rt_nav_height"
        android:scrollbars="none" />

    <include
        android:id="@+id/stateBlock"
        layout="@layout/view_state_block" />

    <LinearLayout
        android:id="@+id/loadingBlock"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/rt_gutter"
        android:paddingEnd="@dimen/rt_gutter"
        android:paddingTop="14dp"
        android:visibility="gone">

        <include layout="@layout/view_machine_skeleton" />

        <include layout="@layout/view_machine_skeleton" />
    </LinearLayout>
</LinearLayout>
