<?xml version="1.0" encoding="utf-8"?>
<!-- One paired phone. This device is renameable; the others can be revoked. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/rt_gutter"
    android:layout_marginEnd="@dimen/rt_gutter"
    android:layout_marginTop="10dp"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="13dp"
    android:paddingEnd="10dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="@drawable/rt_card_clickable"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/rt_icon_tile_quiet">

        <ImageView
            android:layout_width="@dimen/rt_icon_lg"
            android:layout_height="@dimen/rt_icon_lg"
            android:layout_gravity="center"
            android:src="@drawable/ic_rt_phone"
            android:importantForAccessibility="no"
            app:tint="@color/rt_text_secondary" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            style="@style/RtText.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Pixel 8 · This phone" />

        <TextView
            android:id="@+id/subtitle"
            style="@style/RtText.RowMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Online now" />
    </LinearLayout>

    <TextView
        android:id="@+id/revokeButton"
        style="@style/RtText"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/rt_danger"
        android:background="@drawable/rt_button_danger"
        android:clickable="true"
        android:focusable="true"
        android:text="@string/revoke_device" />
</LinearLayout>
