<?xml version="1.0" encoding="utf-8"?>
<!--
  Explanatory note card: a tinted circular glyph, a title and one or two lines.
  Used for the encryption note, the sessions note and the pairing explainer.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/noteCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="80dp"
    android:paddingStart="14dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:background="@drawable/rt_card">

    <FrameLayout
        android:id="@+id/noteIconWell"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/rt_circle_ring">

        <ImageView
            android:id="@+id/noteIcon"
            android:layout_width="@dimen/rt_icon_lg"
            android:layout_height="@dimen/rt_icon_lg"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            tools:src="@drawable/ic_rt_shield"
            app:tint="@color/rt_primary" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/noteTitle"
            style="@style/RtText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11.5sp"
            android:textStyle="bold"
            tools:text="Sessions are encrypted" />

        <TextView
            android:id="@+id/noteBody"
            style="@style/RtText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="9.5sp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/rt_text_muted"
            tools:text="Commands and output are protected in transit." />
    </LinearLayout>
</LinearLayout>
