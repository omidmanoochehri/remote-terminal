<?xml version="1.0" encoding="utf-8"?>
<!-- Search well used by the Machines and Terminals screens. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/searchField"
    android:layout_width="match_parent"
    android:layout_height="43dp"
    android:layout_marginStart="@dimen/rt_gutter"
    android:layout_marginEnd="@dimen/rt_gutter"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="4dp"
    android:background="@drawable/rt_field">

    <ImageView
        android:layout_width="@dimen/rt_icon_lg"
        android:layout_height="@dimen/rt_icon_lg"
        android:src="@drawable/ic_rt_search"
        android:importantForAccessibility="no"
        app:tint="@color/rt_text_muted" />

    <EditText
        android:id="@+id/searchInput"
        style="@style/RtFieldInput"
        android:layout_marginStart="4dp"
        android:textSize="10.5sp"
        android:inputType="text|textNoSuggestions"
        android:imeOptions="actionSearch"
        android:hint="@string/search"
        tools:hint="Search by name, host or operating system"
        tools:ignore="Autofill" />

    <ImageButton
        android:id="@+id/searchClear"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:background="@drawable/rt_icon_button"
        android:src="@drawable/ic_rt_close"
        android:visibility="gone"
        android:contentDescription="@string/clear_search"
        app:tint="@color/rt_text_muted" />
</LinearLayout>
