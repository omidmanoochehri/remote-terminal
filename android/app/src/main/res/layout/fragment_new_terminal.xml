<?xml version="1.0" encoding="utf-8"?>
<!--
  New terminal. Machine, name, shell and working directory, then the two
  behaviours a session can carry, then the action. Advanced options stay
  collapsed because most sessions never need them.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/headerBar"
        layout="@layout/view_back_header" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_xl"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/rt_gutter"
            android:paddingEnd="@dimen/rt_gutter">

            <!-- Machine selector -->
            <LinearLayout
                android:id="@+id/machineCard"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="13dp"
                android:paddingEnd="14dp"
                android:background="@drawable/rt_card_clickable"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/rt_icon_tile_accent">

                    <ImageView
                        android:id="@+id/machineIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_rt_server"
                        android:importantForAccessibility="no"
                        app:tint="@color/rt_primary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RtText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:textColor="@color/rt_text_muted"
                        android:text="@string/label_machine" />

                    <TextView
                        android:id="@+id/machineName"
                        style="@style/RtText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="Cactus Server" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:id="@+id/machineDot"
                            android:layout_width="@dimen/status_dot"
                            android:layout_height="@dimen/status_dot"
                            android:background="@drawable/rt_dot"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/machineStatus"
                            style="@style/RtText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:textSize="10sp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            tools:text="Online · Ubuntu 24.04.4 LTS" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/machineChevron"
                    android:layout_width="@dimen/rt_icon_lg"
                    android:layout_height="@dimen/rt_icon_lg"
                    android:src="@drawable/ic_rt_chevron_down"
                    android:importantForAccessibility="no"
                    app:tint="@color/rt_text_muted" />
            </LinearLayout>

            <!-- Session details -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/rt_card">

                <include
                    android:id="@+id/nameField"
                    layout="@layout/view_form_field" />

                <include
                    android:id="@+id/shellField"
                    layout="@layout/view_form_field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp" />

                <include
                    android:id="@+id/directoryField"
                    layout="@layout/view_form_field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp" />

                <TextView
                    style="@style/RtText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="8.5sp"
                    android:textColor="@color/rt_text_muted"
                    android:text="@string/working_directory_help" />
            </LinearLayout>

            <!-- Behaviour -->
            <LinearLayout
                android:id="@+id/behaviourCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/rt_card">

                <include
                    android:id="@+id/toggleRestore"
                    layout="@layout/view_toggle_row" />

                <View
                    style="@style/RtRowDivider"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp" />

                <include
                    android:id="@+id/toggleNotify"
                    layout="@layout/view_toggle_row" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/advancedToggle"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/rt_button_quiet"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    style="@style/RtText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/rt_text_muted"
                    android:text="@string/advanced_options" />

                <ImageView
                    android:id="@+id/advancedChevron"
                    android:layout_width="@dimen/rt_icon_md"
                    android:layout_height="@dimen/rt_icon_md"
                    android:layout_marginStart="14dp"
                    android:src="@drawable/ic_rt_chevron_down"
                    android:importantForAccessibility="no"
                    app:tint="@color/rt_text_muted" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/advancedPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/rt_card"
                android:visibility="gone">

                <include
                    android:id="@+id/commandField"
                    layout="@layout/view_form_field" />

                <!-- Preset mode only: the command is the point of a preset. -->
                <TextView
                    android:id="@+id/commandHelp"
                    style="@style/RtText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="8.5sp"
                    android:textColor="@color/rt_text_muted"
                    android:visibility="gone"
                    android:text="@string/preset_command_help" />

                <include
                    android:id="@+id/scrollbackField"
                    layout="@layout/view_form_field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/createButton"
                style="@style/RtCta"
                android:layout_height="52dp"
                android:layout_marginTop="26dp">

                <ImageView
                    android:id="@+id/createIcon"
                    android:layout_width="@dimen/rt_icon_lg"
                    android:layout_height="@dimen/rt_icon_lg"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/ic_rt_terminal_square"
                    android:importantForAccessibility="no"
                    app:tint="@color/rt_on_primary" />

                <TextView
                    android:id="@+id/createLabel"
                    style="@style/RtText.Cta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:text="@string/create_terminal" />
            </LinearLayout>

            <!-- Keep this way of starting a terminal for next time. -->
            <LinearLayout
                android:id="@+id/savePresetButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/rt_button_quiet"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="@dimen/rt_icon_md"
                    android:layout_height="@dimen/rt_icon_md"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_rt_bookmark"
                    android:importantForAccessibility="no"
                    app:tint="@color/rt_text_secondary" />

                <TextView
                    style="@style/RtText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/rt_text_secondary"
                    android:text="@string/preset_save_as" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
