<?xml version="1.0" encoding="utf-8"?>
<!-- One entry of a folder on the machine: type icon, name, size and age, and its actions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="@dimen/rt_row_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/rt_gutter"
    android:paddingEnd="4dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="@dimen/rt_tile_sm"
        android:layout_height="@dimen/rt_tile_sm"
        android:background="@drawable/rt_icon_tile_quiet">

        <ImageView
            android:id="@+id/fileIcon"
            android:layout_width="@dimen/rt_icon_md"
            android:layout_height="@dimen/rt_icon_md"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/rt_text_secondary"
            tools:src="@drawable/ic_rt_folder" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="11dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/fileName"
            style="@style/RtText.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="middle"
            tools:text="deploy.sh" />

        <TextView
            android:id="@+id/fileMeta"
            style="@style/RtText.RowMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="4.2 KB · 2 hours ago" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/fileMenu"
        style="@style/Widget.RemoteTerminal.IconButton"
        android:src="@drawable/ic_rt_more"
        android:padding="13dp"
        android:contentDescription="@string/more" />
</LinearLayout>
