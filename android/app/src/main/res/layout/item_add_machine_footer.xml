<?xml version="1.0" encoding="utf-8"?>
<!-- Footer under the machine list: the same outlined action as on Home. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="14dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/addMachineButton"
        style="@style/RtOutlineButton"
        android:layout_gravity="center_horizontal">

        <ImageView
            android:layout_width="@dimen/rt_icon_sm"
            android:layout_height="@dimen/rt_icon_sm"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_rt_plus"
            android:importantForAccessibility="no"
            app:tint="@color/rt_primary" />

        <TextView
            style="@style/RtText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/rt_primary"
            android:text="@string/machines_add_new" />
    </LinearLayout>
</FrameLayout>
