<?xml version="1.0" encoding="utf-8"?>
<!-- Terminals / Details / Settings selector on the machine screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/segment"
    android:layout_width="match_parent"
    android:layout_height="41dp"
    android:layout_marginStart="@dimen/rt_gutter"
    android:layout_marginEnd="@dimen/rt_gutter"
    android:orientation="horizontal"
    android:padding="4dp"
    android:background="@drawable/rt_segment_track">

    <TextView
        android:id="@+id/tabTerminals"
        style="@style/RtSegmentItem"
        android:textSize="9.5sp"
        android:text="@string/tab_terminals" />

    <TextView
        android:id="@+id/tabDetails"
        style="@style/RtSegmentItem"
        android:textSize="9.5sp"
        android:text="@string/tab_details" />

    <TextView
        android:id="@+id/tabSettings"
        style="@style/RtSegmentItem"
        android:textSize="9.5sp"
        android:text="@string/tab_settings" />
</LinearLayout>
