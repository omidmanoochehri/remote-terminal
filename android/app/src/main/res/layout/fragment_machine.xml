<?xml version="1.0" encoding="utf-8"?>
<!--
  One machine. The header and hero stay fixed; the segmented control swaps the
  content below between its terminals and its details. The Settings segment
  pushes the machine settings screen, which is a separate page in the design.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/headerBar"
        layout="@layout/view_back_header" />

    <include
        android:id="@+id/heroCard"
        layout="@layout/view_machine_hero" />

    <include
        android:id="@+id/tabs"
        layout="@layout/view_segmented_tabs" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Terminals -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/terminalsScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="13dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Saved presets for this machine: one tap starts the terminal. -->
                <HorizontalScrollView
                    android:id="@+id/presetScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="13dp"
                    android:clipToPadding="false"
                    android:paddingStart="@dimen/rt_gutter"
                    android:paddingEnd="@dimen/rt_gutter"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/presetRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/terminalList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <FrameLayout
                    android:id="@+id/sessionsNoteHolder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/rt_gutter"
                    android:paddingEnd="@dimen/rt_gutter"
                    android:paddingTop="20dp">

                    <include
                        android:id="@+id/sessionsNote"
                        layout="@layout/view_note_card" />
                </FrameLayout>

                <include
                    android:id="@+id/terminalsEmpty"
                    layout="@layout/view_state_block" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="86dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Details -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/detailsScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="13dp"
            android:visibility="gone"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/rt_gutter"
                android:paddingEnd="@dimen/rt_gutter">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <include
                        android:id="@+id/metricCpu"
                        layout="@layout/view_metric_tile" />

                    <Space android:layout_width="10dp" android:layout_height="1dp" />

                    <include
                        android:id="@+id/metricMemory"
                        layout="@layout/view_metric_tile" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <include
                        android:id="@+id/metricStorage"
                        layout="@layout/view_metric_tile" />

                    <Space android:layout_width="10dp" android:layout_height="1dp" />

                    <include
                        android:id="@+id/metricUptime"
                        layout="@layout/view_metric_tile" />
                </LinearLayout>

                <TextView
                    android:id="@+id/metricsNote"
                    style="@style/RtText.RowMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/metrics_unavailable"
                    android:visibility="gone" />

                <TextView
                    style="@style/RtText.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:text="@string/system_information" />

                <LinearLayout
                    android:id="@+id/infoCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="@drawable/rt_card" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="32dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Primary action, pinned over the terminals tab -->
        <LinearLayout
            android:id="@+id/newTerminalButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="@dimen/rt_gutter"
            android:layout_marginEnd="@dimen/rt_gutter"
            android:layout_marginBottom="@dimen/rt_gutter"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/rt_cta_bg"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/newTerminalIcon"
                android:layout_width="@dimen/rt_icon_lg"
                android:layout_height="@dimen/rt_icon_lg"
                android:layout_marginEnd="14dp"
                android:src="@drawable/ic_rt_plus"
                android:importantForAccessibility="no"
                app:tint="@color/rt_on_primary" />

            <TextView
                android:id="@+id/newTerminalLabel"
                style="@style/RtText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/rt_on_primary"
                android:text="@string/new_terminal" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
