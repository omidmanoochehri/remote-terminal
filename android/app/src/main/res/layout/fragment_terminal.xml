<?xml version="1.0" encoding="utf-8"?>
<!--
  Terminal session. The header identifies the machine with the terminal mark
  (not the app mark), the tab strip carries the open sessions, and the grid
  sits in a rounded well with the command bar, the key grid and a status
  footer beneath it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/terminal_bar_height"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="2dp">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:background="@drawable/rt_icon_button"
                android:src="@drawable/ic_rt_arrow_left"
                android:contentDescription="@string/back"
                app:tint="@color/rt_text" />

            <FrameLayout
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/rt_terminal_mark">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_rt_terminal_square"
                    android:importantForAccessibility="no"
                    app:tint="@color/rt_primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="9dp"
                android:layout_marginEnd="4dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/machineName"
                    style="@style/RtText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Cactus Server" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/machineDot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/rt_dot"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/machineStatus"
                        style="@style/RtText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="8.5sp"
                        android:textColor="@color/rt_text_muted"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="192.168.1.10  •  Ubuntu 24.04" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/searchButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:background="@drawable/rt_icon_button"
                android:src="@drawable/ic_rt_search"
                android:contentDescription="@string/search"
                app:tint="@color/rt_text" />

            <ImageButton
                android:id="@+id/keyboardButton"
                android:layout_width="34dp"
                android:layout_height="31dp"
                android:layout_marginStart="6dp"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:background="@drawable/rt_icon_button_boxed"
                android:src="@drawable/ic_rt_keyboard"
                android:contentDescription="@string/keyboard_toggle"
                app:tint="@color/rt_text" />

            <ImageButton
                android:id="@+id/moreButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:background="@drawable/rt_icon_button"
                android:src="@drawable/ic_rt_more"
                android:contentDescription="@string/more"
                app:tint="@color/rt_text" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="@dimen/terminal_tabs_row_height"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="7dp"
            android:clipToPadding="false"
            android:scrollbars="none" />
    </LinearLayout>

    <!-- Search bar (hidden until requested) -->
    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="43dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="2dp"
        android:background="@drawable/rt_field"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/rt_icon_md"
            android:layout_height="@dimen/rt_icon_md"
            android:src="@drawable/ic_rt_search"
            android:importantForAccessibility="no"
            app:tint="@color/rt_text_muted" />

        <EditText
            android:id="@+id/searchInput"
            style="@style/RtFieldInput"
            android:layout_marginStart="6dp"
            android:textSize="10.5sp"
            android:hint="@string/search_hint"
            android:inputType="text|textNoSuggestions"
            android:imeOptions="actionSearch"
            tools:ignore="Autofill" />

        <TextView
            android:id="@+id/searchCount"
            style="@style/RtText.RowMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />

        <ImageButton
            android:id="@+id/searchPrev"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:background="@drawable/rt_icon_button"
            android:src="@drawable/ic_rt_chevron_up"
            android:contentDescription="@string/search_prev"
            app:tint="@color/rt_text_secondary" />

        <ImageButton
            android:id="@+id/searchNext"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:background="@drawable/rt_icon_button"
            android:src="@drawable/ic_rt_chevron_down"
            android:contentDescription="@string/search_next"
            app:tint="@color/rt_text_secondary" />

        <ImageButton
            android:id="@+id/searchClose"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:background="@drawable/rt_icon_button"
            android:src="@drawable/ic_rt_close"
            android:contentDescription="@string/close_search"
            app:tint="@color/rt_text_secondary" />
    </LinearLayout>

    <!-- The terminal grid inside its well, with the status banner over it -->
    <FrameLayout
        android:id="@+id/terminalFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/rt_terminal_surface">

        <com.cactus.remoteterminal.terminal.TerminalView
            android:id="@+id/terminal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="6dp" />

        <TextView
            android:id="@+id/banner"
            style="@style/RtText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="10dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:background="@drawable/rt_badge_neutral"
            android:textSize="9.5sp"
            android:textColor="@color/rt_text_secondary"
            android:visibility="gone"
            tools:text="Attaching…"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/newLinesChip"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:background="@drawable/rt_badge"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:contentDescription="@string/jump_to_bottom">

            <ImageView
                android:layout_width="@dimen/rt_icon_sm"
                android:layout_height="@dimen/rt_icon_sm"
                android:layout_marginEnd="7dp"
                android:src="@drawable/ic_rt_arrow_down"
                android:importantForAccessibility="no"
                app:tint="@color/rt_primary" />

            <TextView
                android:id="@+id/newLinesText"
                style="@style/RtText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:textColor="@color/rt_primary" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom chrome: padded clear of the navigation bar and the keyboard -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="9dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/commandBar"
            android:layout_width="match_parent"
            android:layout_height="43dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="5dp"
            android:background="@drawable/rt_field"
            android:visibility="gone">

            <TextView
                style="@style/RtText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textColor="@color/rt_text_secondary"
                android:importantForAccessibility="no"
                android:text="@string/command_prompt_glyph" />

            <EditText
                android:id="@+id/commandInput"
                style="@style/RtFieldInput"
                android:layout_marginStart="6dp"
                android:textSize="10.5sp"
                android:fontFamily="@font/terminal_mono"
                android:hint="@string/command_placeholder"
                android:inputType="text|textNoSuggestions"
                android:imeOptions="actionSend"
                tools:ignore="Autofill" />

            <ImageButton
                android:id="@+id/sendButton"
                android:layout_width="36dp"
                android:layout_height="33dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:background="@drawable/rt_send_button"
                android:src="@drawable/ic_rt_send"
                android:contentDescription="@string/send"
                app:tint="@color/white" />
        </LinearLayout>

        <com.cactus.remoteterminal.terminal.ExtraKeysView
            android:id="@+id/extraKeys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp" />

        <!-- Session status: state, transport, how long it has been up -->
        <LinearLayout
            android:id="@+id/statusFooter"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="6dp">

            <View
                android:id="@+id/footerDot"
                android:layout_width="@dimen/status_dot"
                android:layout_height="@dimen/status_dot"
                android:background="@drawable/rt_dot"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/footerState"
                style="@style/RtText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="9dp"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Connected" />

            <ImageView
                android:id="@+id/footerTransportIcon"
                android:layout_width="@dimen/rt_icon_sm"
                android:layout_height="@dimen/rt_icon_sm"
                android:src="@drawable/ic_rt_terminal_square"
                android:importantForAccessibility="no"
                app:tint="@color/rt_text_secondary" />

            <TextView
                android:id="@+id/footerTransport"
                style="@style/RtText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="16dp"
                android:textSize="8.5sp"
                android:textColor="@color/rt_text_secondary"
                tools:text="bash" />

            <ImageView
                android:layout_width="@dimen/rt_icon_sm"
                android:layout_height="@dimen/rt_icon_sm"
                android:src="@drawable/ic_rt_clock"
                android:importantForAccessibility="no"
                app:tint="@color/rt_text_secondary" />

            <TextView
                android:id="@+id/footerUptime"
                style="@style/RtText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:textSize="8.5sp"
                android:textColor="@color/rt_text_secondary"
                tools:text="1h 29m" />

            <ImageButton
                android:id="@+id/footerSettings"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="10dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:background="@drawable/rt_icon_button"
                android:src="@drawable/ic_rt_settings"
                android:contentDescription="@string/terminal_settings"
                app:tint="@color/rt_text_secondary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
