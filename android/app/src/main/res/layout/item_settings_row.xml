<?xml version="1.0" encoding="utf-8"?>
<!--
  One settings row. It carries either a trailing value with a chevron (opens
  something) or a switch (toggles something); the fragment shows exactly one.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settingsRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="13dp"
    android:paddingEnd="13dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:id="@+id/rowIconWell"
        android:layout_width="31dp"
        android:layout_height="31dp"
        android:background="@drawable/rt_settings_icon_well">

        <ImageView
            android:id="@+id/rowIcon"
            android:layout_width="@dimen/rt_icon_md"
            android:layout_height="@dimen/rt_icon_md"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            tools:src="@drawable/ic_rt_moon_star" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="11dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowTitle"
            style="@style/RtText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Theme" />

        <TextView
            android:id="@+id/rowSubtitle"
            style="@style/RtText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="8.2sp"
            android:textColor="@color/rt_text_muted"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="App appearance" />
    </LinearLayout>

    <TextView
        android:id="@+id/rowValue"
        style="@style/RtText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:maxWidth="120dp"
        android:textSize="9sp"
        android:textColor="@color/rt_text_muted"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone"
        tools:text="Dark"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/rowChevron"
        android:layout_width="@dimen/rt_icon_md"
        android:layout_height="@dimen/rt_icon_md"
        android:layout_marginStart="6dp"
        android:src="@drawable/ic_rt_chevron_right"
        android:importantForAccessibility="no"
        app:tint="@color/rt_text_muted" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/rowSwitch"
        style="@style/RtSwitch"
        android:layout_marginStart="8dp"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />
</LinearLayout>
