<?xml version="1.0" encoding="utf-8"?>
<!--
  Skeleton of a machine card, shown for the first moment after a cold start
  while the relay has not answered yet. It mirrors the real card so nothing
  jumps when the data arrives.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="vertical"
    android:background="@drawable/rt_card"
    android:paddingStart="@dimen/rt_card_padding"
    android:paddingEnd="@dimen/rt_card_padding"
    android:paddingTop="@dimen/rt_card_padding_wide"
    android:paddingBottom="@dimen/rt_card_padding_wide"
    android:importantForAccessibility="noHideDescendants">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:layout_width="@dimen/rt_tile_lg"
            android:layout_height="@dimen/rt_tile_lg"
            android:background="@drawable/rt_icon_tile_quiet" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <View
                android:layout_width="140dp"
                android:layout_height="14dp"
                android:background="@drawable/rt_skeleton" />

            <View
                android:layout_width="200dp"
                android:layout_height="9dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/rt_skeleton"
                android:alpha="0.7" />

            <View
                android:layout_width="110dp"
                android:layout_height="9dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/rt_skeleton"
                android:alpha="0.5" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/rt_stat_box_height"
            android:background="@drawable/rt_stat_box" />

        <Space android:layout_width="9dp" android:layout_height="1dp" />

        <View
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/rt_stat_box_height"
            android:background="@drawable/rt_stat_box" />

        <Space android:layout_width="9dp" android:layout_height="1dp" />

        <View
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/rt_stat_box_height"
            android:background="@drawable/rt_stat_box" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="33dp"
        android:layout_marginTop="11dp"
        android:background="@drawable/rt_cta_disabled" />
</LinearLayout>
